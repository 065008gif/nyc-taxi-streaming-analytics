      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Trip Demand by Time of Day",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "P77116FF2B888E3D7"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  CASE\r\n    WHEN HOUR(pickup_datetime) BETWEEN 5 AND 11 THEN 'Morning (5-11)'\r\n    WHEN HOUR(pickup_datetime) BETWEEN 12 AND 16 THEN 'Afternoon (12-16)'\r\n    WHEN HOUR(pickup_datetime) BETWEEN 17 AND 21 THEN 'Evening (17-21)'\r\n    ELSE 'Night (22-4)'\r\n  END AS \"Time of Day\",\r\n  COUNT(*) AS \"Trips\"\r\nFROM sda_assignment3.trips\r\nGROUP BY\r\n  CASE\r\n    WHEN HOUR(pickup_datetime) BETWEEN 5 AND 11 THEN 'Morning (5-11)'\r\n    WHEN HOUR(pickup_datetime) BETWEEN 12 AND 16 THEN 'Afternoon (12-16)'\r\n    WHEN HOUR(pickup_datetime) BETWEEN 17 AND 21 THEN 'Evening (17-21)'\r\n    ELSE 'Night (22-4)'\r\n  END;",
                        "sql": {
                          "columns": [
